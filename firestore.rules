rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Users — anyone authed can read, only self can update limited fields
    match /users/{userId} {
      allow read: if request.auth != null;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['activeGameId', 'lastActiveAt']);
    }

    // Friendships — participants can read, all writes through Functions
    match /friendships/{friendshipId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.users;
    }

    // Games — players and invited users can read, all writes through Functions
    match /games/{gameId} {
      allow read: if request.auth != null
        && (request.auth.uid in resource.data.playerUids
            || request.auth.uid in resource.data.invitedUids);

      // Move history — players can read
      match /moves/{moveId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/games/$(gameId)).data.playerUids;
      }
    }
  }
}
